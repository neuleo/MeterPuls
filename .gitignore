# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments & Environment configs
.env
.venv
env/
venv/
ENV/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/node_modules/
frontend/dist/

# Tests & Cache
.pytest_cache/
.coverage
htmlcov/
.cache/

# IDE & OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# MeterPulse Database & User Uploads (do not commit user photos or local DBs)
data/meterpulse.db*
data/uploads/*
!data/uploads/.gitkeep
backend/data/*
!backend/data/.gitkeep

# Log files
*.log
